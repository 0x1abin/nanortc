menu "ESP32 Camera Example"

    config EXAMPLE_UDP_PORT
        int "Local UDP port for WebRTC"
        default 9999
        range 1024 65535
        help
            UDP port for STUN/DTLS/RTP traffic.

    config EXAMPLE_VIDEO_WIDTH
        int "Video width"
        default 1280
        help
            Camera capture and H264 encode width in pixels.

    config EXAMPLE_VIDEO_HEIGHT
        int "Video height"
        default 960
        help
            Camera capture and H264 encode height in pixels.

    config EXAMPLE_VIDEO_FPS
        int "Video frame rate (fps)"
        default 30
        range 1 60
        help
            Camera capture frame rate. The H264 encoder and RTP sender
            are paced by the camera sensor output rate.

    config EXAMPLE_H264_BITRATE_KBPS
        int "H264 target bitrate (kbps)"
        default 2048
        range 256 8192
        help
            Target bitrate for H264 hardware encoder in kilobits per second.
            This is the CEILING: at runtime the BWE→encoder loop lowers the
            actual encode rate to the link's estimated capacity (see
            NANORTC_EV_BITRATE_ESTIMATE handling in main.c), so prefer
            sizing this to the encoder's comfortable maximum rather than to
            the network. Frame-size budget: every frame must fragment into
            fewer RTP packets than min(NANORTC_OUT_QUEUE_SIZE,
            NANORTC_VIDEO_PKT_RING_SIZE) or nanortc_send_video() rejects it
            — with the 64/64 defaults that is ~75 KB per frame, far above
            what 2048 kbps produces (IDR ≈ 60 KB worst case at 1080p).

    config EXAMPLE_H264_GOP
        int "H264 GOP size (keyframe interval in frames)"
        default 60
        range 1 250
        help
            Group of Pictures size. An IDR keyframe is generated every
            GOP frames. At 25fps, GOP=50 means a keyframe every 2 seconds.
            IDRs are the largest frames the sender ships (5-10× a P-frame),
            so a larger GOP (e.g. 120) halves keyframe burst frequency —
            safe because PLI feedback still forces an IDR on demand when
            the receiver actually loses reference (debounced to 1/s in
            main.c).

endmenu
