# nanortc ESP32 A/V example — CI-only advanced feature profile
#
# This is a complete defaults file because the ESP-IDF workflow copies it over
# sdkconfig.defaults before configuring the advanced matrix entry.

# Custom partition table (factory ~3.6 MB) — needs >= 4 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# mbedTLS DTLS support
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y

# lwIP
CONFIG_LWIP_MAX_SOCKETS=8
CONFIG_LWIP_SO_RCVTIMEO=y
CONFIG_LWIP_SO_REUSE=y

CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Full A/V codec and advanced transport/control feature compile coverage.
CONFIG_NANORTC_FEATURE_VIDEO=y
CONFIG_NANORTC_FEATURE_AUDIO=y
CONFIG_NANORTC_FEATURE_H265=y
# CONFIG_NANORTC_FEATURE_DATACHANNEL is not set
CONFIG_NANORTC_FEATURE_ICE_SRFLX=y
CONFIG_NANORTC_FEATURE_VIDEO_RATE_CONTROL=y
CONFIG_NANORTC_FEATURE_VIDEO_REORDER=y
CONFIG_NANORTC_FEATURE_VIDEO_NACK_RX=y
CONFIG_NANORTC_FEATURE_VIDEO_FEC=y
CONFIG_NANORTC_FEC_ADAPTIVE=y
CONFIG_NANORTC_FEATURE_VIDEO_PACING=y
CONFIG_NANORTC_FEATURE_VIDEO_AUTO_PLI=y

CONFIG_NANORTC_OUT_QUEUE_SIZE=16
CONFIG_NANORTC_TX_SLOT_COUNT=4
CONFIG_NANORTC_MEDIA_BUF_SIZE=1280
